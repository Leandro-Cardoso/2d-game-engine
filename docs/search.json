---
layout: none
---

[
    {%- assign sorted_pages = site.pages | where_exp: "item", "item.title" -%}
    {%- assign filtered_pages = sorted_pages | where_exp: "item", "item.searchable != false" -%}

    {%- for page in filtered_pages -%}
        {
        "category" : "{{ page.category | escape }}",
        "title"    : "{{ page.title | escape }}",
        "url"      : "{{ page.url | relative_url }}",
        "content"  : "{{ page.content | strip_html | strip_newlines | escape | truncatewords: 30 }}"
        }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
]
