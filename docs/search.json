---
layout: none
searchable: false
---

[
    {%- assign documents = site.pages | where_exp: "item", "item.title" | where_exp: "item", "item.searchable != false" -%}
  
    {%- for page in documents -%}
        {
        "category" : "{{ page.category | escape }}",
        "title"    : "{{ page.title | escape }}",
        "tags"     : "{{ page.tags | join: ', ' | escape }}",
        "url"      : "{{ page.url | relative_url }}",
        "content"  : "{{ page.content | strip_html | strip_newlines | escape | truncatewords: 50 }}"
        }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
]
